# URL del backend (Railway). En Netlify, define esta misma variable en Site settings > Environment variables.
VITE_API_URL=https://panel-autoservicio-backend-production-a968.up.railway.app

# (El número de WhatsApp ya no se configura aquí: está fijo en src/Dashboard.jsx.)

# Login con Google — console.cloud.google.com > APIs & Services > Clients
# (mismo Client ID que GOOGLE_CLIENT_ID en el backend). Si se deja vacío,
# el botón de Google simplemente no se muestra.
VITE_GOOGLE_CLIENT_ID=

# Pixel de Meta (Ads) — business.facebook.com > Events Manager > Data sources > Pixel ID.
# Si se deja vacío, el Pixel simplemente no se activa.
VITE_META_PIXEL_ID=
